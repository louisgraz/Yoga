{
  "model_path": "pose_landmarker.task",
  "refs_file": "pose_references.json",
  "yoga82_dir": "Yoga-82",

  "webcam": {
    "index": 0,
    "width": 1280,
    "height": 720
  },

  "feedback": {
    "score_thresholds": { "green": 75, "orange": 50 },
    "hold_duration_s": 5.0,
    "min_hold_score": 70,
    "landmark_visibility_min": 0.5,
    "max_tolerance_deg": 25.0
  },

  "session": {
    "log_dir": "sessions",
    "enabled": true
  },

  "smoothing": {
    "angle_window_frames": 15,
    "_comment_angle_window_frames": "augmenter = plus lisse mais plus lent à réagir",
    "color_debounce_frames": 20,
    "_comment_color_debounce_frames": "augmenter = couleurs plus stables, transitions plus lentes",
    "panel_update_interval_s": 0.5, 
    "_comment_panel_update_interval_s": "augmenter = texte plus lisible, moins de mises à jour"
  },

  "poses": {
    "Warrior I": {
      "reference_image": "Yoga-82/Warrior_I_Pose_or_Virabhadrasana_I_/1_0_68.jpg",
      "angle_keys": [
        "Left Knee", "Right Knee",
        "Left Hip",
        "Left Elbow", "Right Elbow",
        "Left Shoulder", "Right Shoulder"
      ],
      "min_joints": 5,
      "tip": "Front knee at 90 deg — both arms raised straight up"
    },
    "Tree Pose": {
      "reference_image": "Yoga-82/Tree_Pose_or_Vrksasana_/0_48.jpg",
      "angle_keys": [
        "Right Knee", "Right Hip",
        "Left Elbow", "Right Elbow",
        "Left Shoulder", "Right Shoulder"
      ],
      "min_joints": 4,
      "tip": "Standing leg straight — hands in prayer at chest"
    },
    "Triangle": {
      "angle_keys": [
        "Left Knee", "Right Knee",
        "Left Hip",
        "Left Shoulder", "Right Shoulder",
        "Left Elbow", "Right Elbow"
      ],
      "min_joints": 5,
      "tip": "Legs wide and straight — arms vertical, torso tilted"
    }
  }
}